<Application x:Class="EstateFlow.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:EstateFlow.Desktop.Converters"
             xmlns:vm="clr-namespace:EstateFlow.Desktop.Mvvm"
             xmlns:views="clr-namespace:EstateFlow.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisConverter"/>
            <converters:PauseToLabelConverter x:Key="PauseToLabelConverter"/>
            <converters:ReconLabelConverter x:Key="ReconLabelConverter"/>

            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EstatesViewModel}">
                <views:EstatesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EstateDetailViewModel}">
                <views:EstateDetailView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiaryViewModel}">
                <views:DiaryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DocumentScanViewModel}">
                <views:DocumentScanView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EstateFormViewModel}">
                <views:EstateFormView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>