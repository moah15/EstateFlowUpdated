<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════ Colours ══════════════ -->

    <Color x:Key="BgMainColor">#16181C</Color>
    <Color x:Key="BgPanelColor">#22252A</Color>
    <Color x:Key="BorderColor">#22252A</Color>
    <Color x:Key="AccentColor">#6E2A2A</Color>
    <Color x:Key="TextMutedColor">#9CA0A8</Color>
    <Color x:Key="TextDimColor">#6B6E76</Color>
    <Color x:Key="TextBrightColor">#F5F4F1</Color>
    <Color x:Key="UrgentOverdueColor">#8B3A3A</Color>
    <Color x:Key="UrgentDueSoonColor">#9C7A3C</Color>
    <Color x:Key="UrgentNormalColor">#3F5B45</Color>

    <SolidColorBrush x:Key="BgMainBrush"
                     Color="{StaticResource BgMainColor}"/>

    <SolidColorBrush x:Key="BgPanelBrush"
                     Color="{StaticResource BgPanelColor}"/>

    <SolidColorBrush x:Key="BorderBrush"
                     Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}"/>

    <SolidColorBrush x:Key="TextMutedBrush"
                     Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="TextDimBrush"
                     Color="{StaticResource TextDimColor}"/>

    <SolidColorBrush x:Key="TextBrightBrush"
                     Color="{StaticResource TextBrightColor}"/>

    <SolidColorBrush x:Key="UrgentOverdueBrush"
                     Color="{StaticResource UrgentOverdueColor}"/>

    <SolidColorBrush x:Key="UrgentDueSoonBrush"
                     Color="{StaticResource UrgentDueSoonColor}"/>

    <SolidColorBrush x:Key="UrgentNormalBrush"
                     Color="{StaticResource UrgentNormalColor}"/>


    <!-- ══════════════ Fonts ══════════════ -->

    <!--
        Pack URI font references.
        The TTF files must be inside /Fonts
        with Build Action = Resource.
    -->

    <FontFamily x:Key="SerifFont">
        /EstateFlow.Desktop;component/Fonts/#Source Serif 4
    </FontFamily>

    <FontFamily x:Key="MonoFont">
        /EstateFlow.Desktop;component/Fonts/#IBM Plex Mono
    </FontFamily>

    <FontFamily x:Key="SansFont">
        /EstateFlow.Desktop;component/Fonts/#Inter
    </FontFamily>


    <!-- ══════════════ Text Styles ══════════════ -->

    <!-- Wordmark / large headings -->
    <Style x:Key="HeadingSerifStyle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource SerifFont}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextBrightBrush}"/>

        <Setter Property="FontSize"
                Value="26"/>

    </Style>


    <!-- Small mono labels / captions -->
    <Style x:Key="MonoLabelStyle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource MonoFont}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextMutedBrush}"/>

        <Setter Property="FontSize"
                Value="11"/>

    </Style>


    <!-- Standard body / UI text -->
    <Style x:Key="BodyTextStyle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource SansFont}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextBrightBrush}"/>

        <Setter Property="FontSize"
                Value="13"/>

    </Style>


    <!-- ══════════════ Input Styles ══════════════ -->

    <Style x:Key="DarkTextBoxStyle"
           TargetType="TextBox">

        <Setter Property="Background"
                Value="{StaticResource BgPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextBrightBrush}"/>

        <Setter Property="FontFamily"
                Value="{StaticResource SansFont}"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Padding"
                Value="10,8"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CaretBrush"
                Value="{StaticResource TextBrightBrush}"/>

    </Style>


    <Style x:Key="DarkPasswordBoxStyle"
           TargetType="PasswordBox">

        <Setter Property="Background"
                Value="{StaticResource BgPanelBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextBrightBrush}"/>

        <Setter Property="FontFamily"
                Value="{StaticResource SansFont}"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Padding"
                Value="10,8"/>

        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CaretBrush"
                Value="{StaticResource TextBrightBrush}"/>

    </Style>


    <!-- ══════════════ Primary Button ══════════════ -->

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button">

        <Setter Property="Background"
                Value="{StaticResource AccentBrush}"/>

        <Setter Property="Foreground"
                Value="{StaticResource TextBrightBrush}"/>

        <Setter Property="FontFamily"
                Value="{StaticResource SansFont}"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="Padding"
                Value="14,10"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="Cursor"
                Value="Hand"/>

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- ══════════════ Estate Detail Styles ══════════════ -->


    <!-- Section card -->

    <Style x:Key="SectionCardBorderStyle"
           TargetType="Border">

        <Setter Property="Background"
                Value="#FFFFFF"/>

        <Setter Property="BorderBrush"
                Value="#E4E2DD"/>

        <Setter Property="BorderThickness"
                Value="1"/>

        <Setter Property="CornerRadius"
                Value="4"/>

        <Setter Property="Padding"
                Value="20,18"/>

        <Setter Property="Margin"
                Value="0,0,0,12"/>

    </Style>


    <!-- Section heading -->

    <Style x:Key="SectionTitleStyle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource MonoFont}"/>

        <Setter Property="Foreground"
                Value="#9CA0A8"/>

        <Setter Property="FontSize"
                Value="10"/>

        <Setter Property="Margin"
                Value="0,0,0,12"/>

    </Style>


    <!-- Field label -->

    <Style x:Key="FieldLabelStyle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource SansFont}"/>

        <Setter Property="Foreground"
                Value="#6B6E76"/>

        <Setter Property="FontSize"
                Value="12"/>

    </Style>


    <!-- Field value -->

    <Style x:Key="FieldValueStyle"
           TargetType="TextBlock">

        <Setter Property="FontFamily"
                Value="{StaticResource SansFont}"/>

        <Setter Property="Foreground"
                Value="#16181C"/>

        <Setter Property="FontSize"
                Value="13"/>

        <Setter Property="TextWrapping"
                Value="Wrap"/>

    </Style>


    <!-- Mono field value -->

    <Style x:Key="FieldValueMonoStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource FieldValueStyle}">

        <Setter Property="FontFamily"
                Value="{StaticResource MonoFont}"/>

        <Setter Property="FontSize"
                Value="12"/>

    </Style>


    <!-- IMPORTANT:
         ResourceDictionary closes HERE,
         after every style.
    -->

</ResourceDictionary>