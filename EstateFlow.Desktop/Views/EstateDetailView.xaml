                                    <TextBlock Text="Make"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetMake, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <TextBlock Text="Valuer" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewAssetValuerName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Valuation Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding NewAssetValuationDate}" Padding="8,6" Margin="0,0,0,12"/>

                                <StackPanel Visibility="{Binding NewAssetIsRegisteredShare, Converter={StaticResource BoolToVisConverter}}">
