                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.Beneficiaries}">
