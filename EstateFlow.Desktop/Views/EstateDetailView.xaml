                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetShareCompany, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Number of Shares" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetNumberOfShares, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}"/>

                                    <TextBlock Text="Share Class (e.g. Ordinary)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetShareClass, UpdateSourceTrigger=PropertyChanged}"/>

                                    <TextBlock Text="Price per Share (cents)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetPriceCents, UpdateSourceTrigger=PropertyChanged}"
