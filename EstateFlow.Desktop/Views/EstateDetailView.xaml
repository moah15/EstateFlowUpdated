                                <Button Content="+ Add Asset"
                                        Command="{Binding AddMovableAssetCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.MovableAssets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource FieldValueStyle}"/>

                                                <TextBlock Text="{Binding Value, StringFormat='R {0:N2}'}"
                                                           Style="{StaticResource FieldValueMonoStyle}"
                                                           Margin="0,4,0,10"/>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Registration No."
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RegistrationNumber}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="VIN"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding VinNumber}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Make"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Make}"
                                                               Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Valued By" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ValuationSummary}" Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Shares" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ShareDetails}" Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Disposition" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DispositionSummary}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"/>
                                                </Grid>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top">

                                                <Button Content="Generate Traffic Letter"
                                                        Command="{Binding DataContext.GenerateVehicleLetterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding AssetId}"
                                                        Background="#6E2A2A"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,8"/>

                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.DeleteMovableAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding AssetId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#8B3A3A"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

