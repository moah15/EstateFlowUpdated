            <!-- ================================================= -->
            <!-- CLAIMS -->
            <!-- ================================================= -->

            <TabItem Header="Claims">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD FINANCIAL CLAIM" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Institution Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimInstitutionName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Institution Address" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimInstitutionAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Account Reference" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimAccountReference, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="Claim Type" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" Text="{Binding NewClaimType, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Bank account"/>
                                    <ComboBoxItem Content="Loan account (debtor)"/>
                                    <ComboBoxItem Content="Policy / insurance proceeds"/>
                                    <ComboBoxItem Content="Pension / provident fund benefit"/>
                                    <ComboBoxItem Content="Usufruct"/>
                                    <ComboBoxItem Content="Fiduciary interest"/>
                                    <ComboBoxItem Content="Refund (SARS / municipality)"/>
                                    <ComboBoxItem Content="Loan to beneficiary"/>
                                </ComboBox>
                                <CheckBox Content="Claim is in favour of the estate (untick = counts as a liability)" IsChecked="{Binding NewClaimInFavour}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Text="Capital Value (R)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="Accrued Interest at Date of Death (R)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimAccruedInterest, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="Valuation Date" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding NewClaimValuationDate}" Padding="8,6" Margin="0,0,0,12"/>
                                <CheckBox Content="Credit life insurance (settles a liability)" IsChecked="{Binding NewClaimIsCreditLife}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Text="Linked Liability / Note" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimLinkedLiabilityNote, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="Collected by the estate as cash" IsChecked="{Binding NewClaimIsCollected}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding NewClaimIsCollected, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Amount Collected (R)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewClaimCollectedAmount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="Date Collected" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding NewClaimCollectedDate}" Padding="8,6" Margin="0,0,0,12"/>
                                </StackPanel>
                                <TextBlock Text="Awarded To (tick heirs)" Style="{StaticResource FieldLabelStyle}"/>
                                <ItemsControl ItemsSource="{Binding ClaimHeirOptions}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsSelected}"
                                                      FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox Content="Special bequest" IsChecked="{Binding NewClaimIsSpecialBequest}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                                <Button Content="+ Add Claim"
                                        Command="{Binding AddFinancialClaimCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.FinancialClaims}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">

                                                <TextBlock Text="{Binding InstitutionName}"
                                                           FontFamily="{StaticResource SerifFont}"
                                                           FontSize="15"
                                                           Foreground="#16181C"
                                                           Margin="0,0,0,10"/>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Address"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding InstitutionAddress}"
                                                               Style="{StaticResource FieldValueStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Account Reference"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AccountReference}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>

                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="Value"
                                                               Style="{StaticResource FieldLabelStyle}"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value, StringFormat='R {0:N2}'}"
                                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Type" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ClaimType}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Accrued Interest" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AccruedInterest, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Total at Death" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TotalAtDeath, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Disposition" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding DispositionSummary}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"/>
                                                </Grid>


                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Top">

                                                <Button Content="Generate Institution Letter"
                                                        Command="{Binding DataContext.GenerateInstitutionLetterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding ClaimId}"
                                                        Background="#6E2A2A"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,8"/>

                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.DeleteFinancialClaimCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding ClaimId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#8B3A3A"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ================================================= -->
            <!-- LIABILITIES -->
            <!-- ================================================= -->

            <TabItem Header="Liabilities">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="ADD LIABILITY" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Creditor Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilityCreditorName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox IsEditable="True" Text="{Binding NewLiabilityCategory, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Funeral expenses"/>
                                    <ComboBoxItem Content="Medical expenses"/>
                                    <ComboBoxItem Content="Mortgage bond"/>
                                    <ComboBoxItem Content="Vehicle finance"/>
                                    <ComboBoxItem Content="Credit card"/>
                                    <ComboBoxItem Content="Personal loan"/>
                                    <ComboBoxItem Content="Retail / store account"/>
                                    <ComboBoxItem Content="Municipal rates and taxes"/>
                                    <ComboBoxItem Content="SARS (income tax)"/>
                                    <ComboBoxItem Content="Levies (body corporate)"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                                <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilityDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Account Reference" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilityAccountReference, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="Amount at Date of Death (R)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilityAmount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="Interest After Date of Death (R)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilityInterestAfterDeath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewLiabilityStatus}" Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Admitted"/>
                                    <ComboBoxItem Content="Pending"/>
                                    <ComboBoxItem Content="Disputed"/>
                                    <ComboBoxItem Content="Rejected"/>
                                </ComboBox>
                                <TextBlock Text="Date Claim Lodged" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding NewLiabilityDateLodged}" Padding="8,6" Margin="0,0,0,12"/>
                                <TextBlock Text="Secured Against (e.g. property / vehicle)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilitySecuredAgainst, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="Taken over by an heir with the asset" IsChecked="{Binding NewLiabilityTakenOverByHeir}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>
                                <CheckBox Content="Covered by credit life insurance" IsChecked="{Binding NewLiabilityCreditLife}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>
                                <CheckBox Content="Paid by the estate" IsChecked="{Binding NewLiabilityIsPaid}" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>
                                <StackPanel Visibility="{Binding NewLiabilityIsPaid, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Amount Paid (R)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}" Text="{Binding NewLiabilityAmountPaid, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="Date Paid" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding NewLiabilityDatePaid}" Padding="8,6" Margin="0,0,0,12"/>
                                </StackPanel>

                                <Button Content="+ Add Liability"
                                        Command="{Binding AddLiabilityCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Estate.Liabilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CreditorName}"
                                                           FontFamily="{StaticResource SerifFont}"
                                                           FontSize="15"
                                                           Foreground="#16181C"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontFamily="{StaticResource SansFont}"
                                                           FontSize="11"
                                                           Foreground="#6B6E76"
                                                           Margin="0,4,0,6"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Amount, StringFormat='R {0:N2}'}"
                                                           Style="{StaticResource FieldValueMonoStyle}"/>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Category" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Account Reference" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding AccountReference}" Style="{StaticResource FieldValueMonoStyle}" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Style="{StaticResource FieldRowGrid}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Status" Style="{StaticResource FieldLabelStyle}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusSummary}" Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"/>
                                                </Grid>

                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.DeleteLiabilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding LiabilityId}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8B3A3A"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="11"
                                                    Cursor="Hand"/>
