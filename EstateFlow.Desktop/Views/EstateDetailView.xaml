                                    <ComboBoxItem Content="Furniture / Household Goods"/>
                                    <ComboBoxItem Content="Cash"/>
                                    <ComboBoxItem Content="Unit Trust"/>
                                    <ComboBoxItem Content="Investment / Savings"/>
                                    <ComboBoxItem Content="Business Interest"/>
                                    <ComboBoxItem Content="Other"/>
