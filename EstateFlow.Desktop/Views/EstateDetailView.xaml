                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- LIQUIDATION & DISTRIBUTION -->
            <!-- ================================================= -->


            <!-- ================================================= -->
            <!-- CASHBOOK -->
            <!-- ================================================= -->
            <TabItem Header="Cashbook">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                        <!-- Add Entry -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="ADD CASHBOOK ENTRY" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding EntryTypes}"
                                              SelectedValue="{Binding NewEntryType}"
                                              FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewEntryCategory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource QuickAddTextBox}" Margin="0,0,6,0"
                                             Tag="Category"/>
                                    <TextBox Grid.Column="2" Text="{Binding NewEntryDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource QuickAddTextBox}" Margin="0,0,6,0"
                                             Tag="Description / Payee"/>
                                    <TextBox Grid.Column="3" Text="{Binding NewEntryAmountText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource QuickAddTextBox}" Margin="0,0,6,0"
                                             Tag="Amount (R)"/>
                                    <DatePicker Grid.Column="4" SelectedDate="{Binding NewEntryDate}"
                                                FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,6,0"/>
                                    <Button Grid.Column="5" Content="Add"
                                            Command="{Binding AddCashbookEntryCommand}"
                                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                            Padding="10,6" FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Filters + Totals -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <ComboBox ItemsSource="{Binding CashbookTypeOptions}"
                                                  SelectedValue="{Binding CashbookTypeFilter}"
                                                  FontFamily="{StaticResource SansFont}" FontSize="12"
                                                  Width="120" Margin="0,0,8,0"/>
                                        <TextBox Text="{Binding CashbookSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource QuickAddTextBox}" Width="180" Tag="Search..." Margin="0,0,8,0"/>
                                        <CheckBox Content="Unreconciled only"
                                                  IsChecked="{Binding CashbookUnreconciledOnly}"
                                                  FontFamily="{StaticResource SansFont}" FontSize="12"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="Clear Filters" Command="{Binding ClearCashbookFiltersCommand}"
                                                Background="Transparent" BorderBrush="#9C7A3C" BorderThickness="1"
                                                Foreground="#9C7A3C" Padding="8,4" FontSize="12"
                                                FontFamily="{StaticResource SansFont}" Cursor="Hand"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Download Cashbook PDF"
                                            Command="{Binding DownloadCashbookPdfCommand}"
                                            Background="#3F5B45" Foreground="White" BorderThickness="0"
                                            Padding="12,6" FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"/>
                                </Grid>

                                <!-- Totals row -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Background="#F0F8F0" CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Receipts" FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#6B6E76"/>
                                            <TextBlock Text="{Binding CashbookTotalReceipts, StringFormat='R {0:N2}'}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="#3F5B45" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#FDF0F0" CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Payments" FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#6B6E76"/>
                                            <TextBlock Text="{Binding CashbookTotalPayments, StringFormat='R {0:N2}'}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="#6E2A2A" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F5F0E8" CornerRadius="4" Padding="12,6" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Balance" FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#6B6E76"/>
                                            <TextBlock Text="{Binding CashbookBalance, StringFormat='R {0:N2}'}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="#16181C" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#F8F8F0" CornerRadius="4" Padding="12,6">
                                        <StackPanel>
                                            <TextBlock Text="Unreconciled" FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="#6B6E76"/>
                                            <TextBlock Text="{Binding CashbookUnreconciledCount}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="#9C7A3C" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cashbook rows -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <ItemsControl ItemsSource="{Binding FilteredCashbook}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8E6E0" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>


                                                <TextBlock Grid.Column="2" Text="{Binding Category}"
                                                           FontFamily="{StaticResource SansFont}" FontSize="11" VerticalAlignment="Center" Foreground="#6B6E76"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Description}"
                                                           FontFamily="{StaticResource SansFont}" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='R {0:N2}'}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="5" Text="{Binding IsReconciled, Converter={StaticResource BoolToVisConverter}}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" Foreground="#3F5B45"/>
                                                <Button Grid.Column="6" Content="{Binding IsReconciled, Converter={StaticResource ReconLabelConverter}}"
                                                        Command="{Binding DataContext.ToggleReconciledCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderBrush="#9C7A3C" BorderThickness="1"
                                                        Foreground="#9C7A3C" Padding="4,2" FontSize="10"
                                                        FontFamily="{StaticResource SansFont}" Cursor="Hand" Margin="4,0"/>
                                                <Button Grid.Column="7" Content="Del"
                                                        Command="{Binding DataContext.DeleteCashbookEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderBrush="#CC4444" BorderThickness="1"
                                                        Foreground="#CC4444" Padding="4,2" FontSize="10"
                                                        FontFamily="{StaticResource SansFont}" Cursor="Hand"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- CHECKLIST -->
            <!-- ================================================= -->


            <TabItem Header="Checklist">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                        <!-- Header + Seed -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ESTATE TASK CHECKLIST" Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{Binding ChecklistSummary}"
                                                   FontFamily="{StaticResource SansFont}" FontSize="12" Foreground="#6B6E76"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Load Standard SA Tasks"
                                            Command="{Binding SeedChecklistCommand}"
                                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                            Padding="12,7" FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>



                        <!-- Add custom task -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="ADD CUSTOM TASK" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewChecklistTask, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource QuickAddTextBox}" Tag="Task description" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Add"
                                            Command="{Binding AddChecklistItemCommand}"
                                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                            Padding="10,6" FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Filter -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding ChecklistStatusOptions}"
                                          SelectedValue="{Binding ChecklistStatusFilter}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12"
                                          Width="130" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding ChecklistSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource QuickAddTextBox}" Width="200" Tag="Search tasks..."/>
                            </StackPanel>
                        </Border>

                        <!-- Task list -->
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <ItemsControl ItemsSource="{Binding FilteredChecklist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8E6E0" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="14"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <TextBlock Text="{Binding TaskName}"
                                                               FontFamily="{StaticResource SansFont}" FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock FontFamily="{StaticResource SansFont}" FontSize="10"
           Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#6B6E76"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="#9C3A3A"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                           FontFamily="{StaticResource SansFont}" FontSize="11"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CompletedDate, StringFormat='{}{0:dd MMM yy}'}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                           VerticalAlignment="Center" Foreground="#6B6E76"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                    <Button Content="Start"
                                                            Command="{Binding DataContext.StartChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderBrush="#9C7A3C" BorderThickness="1"
                                                            Foreground="#9C7A3C" Padding="4,2" FontSize="10"
                                                            FontFamily="{StaticResource SansFont}" Cursor="Hand" Margin="2,0"/>
                                                    <Button Content="Done"
                                                            Command="{Binding DataContext.DoneChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderBrush="#3F5B45" BorderThickness="1"
                                                            Foreground="#3F5B45" Padding="4,2" FontSize="10"
                                                            FontFamily="{StaticResource SansFont}" Cursor="Hand" Margin="2,0"/>
                                                    <Button Content="N/A"
                                                            Command="{Binding DataContext.NaChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderBrush="#6B6E76" BorderThickness="1"
                                                            Foreground="#6B6E76" Padding="4,2" FontSize="10"
                                                            FontFamily="{StaticResource SansFont}" Cursor="Hand" Margin="2,0"/>
                                                    <Button Content="Reopen"
                                                            Command="{Binding DataContext.ReopenChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderBrush="#9C7A3C" BorderThickness="1"
                                                            Foreground="#9C7A3C" Padding="4,2" FontSize="10"
                                                            FontFamily="{StaticResource SansFont}" Cursor="Hand" Margin="2,0"/>
                                                    <Button Content="Del"
                                                            Command="{Binding DataContext.DeleteChecklistItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderBrush="#CC4444" BorderThickness="1"
                                                            Foreground="#CC4444" Padding="4,2" FontSize="10"
                                                            FontFamily="{StaticResource SansFont}" Cursor="Hand" Margin="2,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- HISTORY (AUDIT) -->
            <!-- ================================================= -->
            <TabItem Header="History">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="AUDIT HISTORY" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBox Text="{Binding AuditSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource QuickAddTextBox}" Width="260"
                                         Tag="Search history..." HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <ItemsControl ItemsSource="{Binding FilteredAudit}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E8E6E0" BorderThickness="0,0,0,1" Padding="0,7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:dd MMM yy HH:mm}'}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ChangedBy}"
                                                           FontFamily="{StaticResource SansFont}" FontSize="11" VerticalAlignment="Center" Foreground="#6B6E76"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Action}"
                                                           FontFamily="{StaticResource SansFont}" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Details}"
                                                           FontFamily="{StaticResource SansFont}" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Foreground="#6B6E76"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="L&amp;D Account">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="820"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="DRAFT LIQUIDATION &amp; DISTRIBUTION ACCOUNT"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="This is a working draft calculated from EstateFlow's captured assets, claims, liabilities, administration expenses and beneficiaries. It should be reviewed before use as a formal account."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           Foreground="#6B6E76"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <Button Content="Refresh Draft"
                                        Command="{Binding RefreshLiquidationDistributionCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="ESTATE SUMMARY"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding LiquidationDistributionDraft.DeceasedName}"
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="16"
                                           Foreground="#16181C"/>
                                <TextBlock Text="{Binding LiquidationDistributionDraft.FileNumber, StringFormat='File: {0}'}"
                                           Style="{StaticResource FieldValueMonoStyle}"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LiquidationDistributionDraft.MastersReference, StringFormat='Master: {0}'}"
                                           Style="{StaticResource FieldValueMonoStyle}"/>

                                <Button Content="Download L&amp;D Account (PDF)"
                                        Command="{Binding DownloadLiquidationAccountCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="LIQUIDATION ACCOUNT"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Movable Assets" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.MovableAssetsTotal, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Immovable Properties" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.ImmovableAssetsTotal, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Financial Claims" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.FinancialClaimsTotal, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Gross Estate" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.GrossEstateTotal, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Liabilities" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.LiabilitiesTotal, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Administration Expenses" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.AdministrationExpenses, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Residue for Distribution" Style="{StaticResource FieldLabelStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiquidationDistributionDraft.ResidueForDistribution, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="DISTRIBUTION DRAFT"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding LiquidationDistributionDraft.BeneficiaryCount, StringFormat='Beneficiaries captured: {0}'}"
                                           Style="{StaticResource FieldValueStyle}"/>
                                <TextBlock Text="{Binding LiquidationDistributionDraft.EqualIndicativeShare, StringFormat='Indicative equal share: R {0:N2}'}"
                                           Style="{StaticResource FieldValueMonoStyle}"
                                           Margin="0,4,0,12"/>

                                <ItemsControl ItemsSource="{Binding LiquidationDistributionDraft.Beneficiaries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FullName}" Style="{StaticResource FieldValueStyle}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding IndicativeEqualShare, StringFormat='R {0:N2}'}"
                                                           Style="{StaticResource FieldValueMonoStyle}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- DIARY -->
            <!-- ================================================= -->

            <TabItem Header="Diary">
                <ScrollViewer Padding="20"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <!-- ADD DIARY ENTRY -->

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD DIARY ENTRY"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Note"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewDiaryNote, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="65"/>

                                <TextBlock Text="Due Date"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <DatePicker SelectedDate="{Binding NewDiaryDueDate, Mode=TwoWay}"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Padding="6"
                                            Margin="0,0,0,10"/>

                                <TextBlock Text="Notification Method"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox SelectedValue="{Binding NewDiaryNotifyBy, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          FontFamily="{StaticResource SansFont}"
                                          FontSize="12"
                                          Padding="6"
                                          Margin="0,0,0,12">

                                    <ComboBoxItem Content="InApp"/>
                                    <ComboBoxItem Content="Email"/>
                                    <ComboBoxItem Content="Both"/>
                                </ComboBox>

                                <Button Content="+ Add Diary Entry"
                                        Command="{Binding AddDiaryEntryCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,7"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>

                            </StackPanel>
                        </Border>

                        <!-- EXISTING DIARY ENTRIES -->

                        <ItemsControl ItemsSource="{Binding Estate.DiaryEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Style="{StaticResource SectionCardBorderStyle}">
                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,20,0">

                                                <TextBlock Text="{Binding Note}"
                                                           Style="{StaticResource FieldValueStyle}"
                                                           TextWrapping="Wrap"/>

                                                <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:dd MMM yyyy}'}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="11"
                                                           Foreground="#6B6E76"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock Text="{Binding NotifyBy, StringFormat='Notify by: {0}'}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="10"
                                                           Foreground="#9CA0A8"
                                                           Margin="0,3,0,0"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,8,0,0">

                                                    <TextBlock Text="Status: "
                                                               FontFamily="{StaticResource SansFont}"
                                                               FontSize="11"
                                                               Foreground="#6B6E76"/>

                                                    <TextBlock Text="{Binding IsCompleted, StringFormat='Completed: {0}'}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="#6E2A2A"/>
                                                </StackPanel>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">

                                                <Button Content="Open / Read"
                                                        Command="{Binding DataContext.OpenDiaryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderBrush="#E4E2DD"
                                                        BorderThickness="1"
                                                        Foreground="#16181C"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,7"/>

                                                <Button Content="Complete / Reopen"
                                                        Command="{Binding DataContext.ToggleDiaryCompleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderBrush="#E4E2DD"
                                                        BorderThickness="1"
                                                        Foreground="#16181C"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,7"/>

                                                <Button Content="Remove"
                                                        Command="{Binding DataContext.DeleteDiaryEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding DiaryId}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#8B3A3A"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"/>

                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- PROGRESS -->
            <!-- ================================================= -->

            <TabItem Header="Progress">
                <ScrollViewer Padding="20"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel MaxWidth="860"
                                HorizontalAlignment="Left">

                        <!-- FOUR-STAGE WORKFLOW -->

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="ADMINISTRATION WORKFLOW" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Style="{StaticResource FieldValueStyle}" TextWrapping="Wrap"
                                               Text="Stage 1 Report &amp; Letters of Executorship · Stage 2 Administration · Stage 3 L&amp;D Account · Stage 4 Inspection &amp; distribution. Creates the four stages with target dates and the key diary reminders (Section 29 advert, valuations, SARS, creditors, 21-day inspection, final tax clearance). Dates are templates – adjust them to this estate."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Start 4-stage workflow"
                                        Command="{Binding StartStbbWorkflowCommand}"
                                        Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                        Padding="14,8" FontFamily="{StaticResource SansFont}" FontSize="12"
                                        Cursor="Hand" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- CURRENT PROGRESS SUMMARY -->

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Background="#FBFAF8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,24,0">
                                    <TextBlock Text="CURRENT ESTATE PROGRESS"
                                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock Text="{Binding CurrentProgressTitle}"
                                               FontFamily="{StaticResource SerifFont}"
                                               FontSize="22"
                                               Foreground="#16181C"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="{Binding CurrentProgressSummary}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#EFEAE4"
                                        CornerRadius="3"
                                        Padding="10,6"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CurrentProgressStatus}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="#6E2A2A"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ADD UPDATE -->

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ADD PROGRESS UPDATE"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Record anything important that happened on the estate — calls, reports sent, documents received, follow-ups, submissions or the current stage."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="12"
                                           Foreground="#6B6E76"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Progress Update"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                                 Text="{Binding NewStageName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Example: Report sent to heirs"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Date"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker SelectedDate="{Binding NewStageTargetDate, Mode=TwoWay}"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="12"
                                                    Padding="6"
                                                    Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox SelectedValue="{Binding NewStageStatus, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  FontFamily="{StaticResource SansFont}"
                                                  FontSize="12"
                                                  Padding="6"
                                                  Margin="0,0,0,10">
                                            <ComboBoxItem Content="Pending" Tag="Pending"/>
                                            <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                                            <ComboBoxItem Content="Complete" Tag="Complete"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Button Content="+ Add Progress Update"
                                        Command="{Binding AddProgressStageCommand}"
                                        Background="#6E2A2A"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="14,8"
                                        FontFamily="{StaticResource SansFont}"
                                        FontSize="12"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- EDIT SELECTED UPDATE -->

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,16,0,0"
                                Background="#FFFDF9"
                                Visibility="{Binding IsEditingProgress, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="EDIT SELECTED UPDATE"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Progress Update"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Style="{StaticResource QuickAddTextBox}"
                                                 Text="{Binding EditingProgressTitle, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="0,0,12,0">
                                        <TextBlock Text="Date"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <DatePicker SelectedDate="{Binding EditingProgressDate, Mode=TwoWay}"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="12"
                                                    Padding="6"
                                                    Margin="0,0,0,10"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Status"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox SelectedValue="{Binding EditingProgressStatus, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  FontFamily="{StaticResource SansFont}"
                                                  FontSize="12"
                                                  Padding="6"
                                                  Margin="0,0,0,10">
                                            <ComboBoxItem Content="Pending" Tag="Pending"/>
                                            <ComboBoxItem Content="In Progress" Tag="InProgress"/>
                                            <ComboBoxItem Content="Complete" Tag="Complete"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save Changes"
                                            Command="{Binding SaveProgressStageCommand}"
                                            Background="#16181C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="14,8"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Cancel"
                                            Command="{Binding CancelProgressEditCommand}"
                                            Background="Transparent"
                                            BorderBrush="#E4E2DD"
                                            BorderThickness="1"
                                            Foreground="#16181C"
                                            Padding="14,8"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TIMELINE -->

                        <TextBlock Text="PROGRESS TIMELINE"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,24,0,10"/>

                        <ItemsControl ItemsSource="{Binding Estate.ProgressStages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TargetDate, StringFormat='{}{0:dd MMM yyyy}'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="#6B6E76"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,15,12,0"/>

                                        <Grid Grid.Column="1">
                                            <Border Width="1"
                                                    Background="#D8D5CF"
                                                    HorizontalAlignment="Center"/>
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     Fill="#6E2A2A"
                                                     VerticalAlignment="Top"
                                                     Margin="0,16,0,0"/>
                                        </Grid>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource SectionCardBorderStyle}"
                                                Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,20,0">
                                                    <TextBlock Text="{Binding StageName}"
                                                               FontFamily="{StaticResource SerifFont}"
                                                               FontSize="16"
                                                               Foreground="#16181C"
                                                               TextWrapping="Wrap"/>

                                                    <Border Background="#F5F4F1"
                                                            BorderBrush="#E4E2DD"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="8,3"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Status}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10"
                                                                   Foreground="#6E2A2A"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Content="Edit"
                                                            Command="{Binding DataContext.EditProgressStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent"
                                                            BorderBrush="#E4E2DD"
                                                            BorderThickness="1"
                                                            Foreground="#16181C"
                                                            FontFamily="{StaticResource SansFont}"
                                                            FontSize="11"
                                                            Padding="10,6"
                                                            Cursor="Hand"
                                                            Margin="0,0,8,0"/>

                                                    <Button Content="Remove"
                                                            Command="{Binding DataContext.DeleteProgressStageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding StageId}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Foreground="#8B3A3A"
                                                            FontFamily="{StaticResource SansFont}"
                                                            FontSize="11"
                                                            Padding="10,6"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>

</UserControl>