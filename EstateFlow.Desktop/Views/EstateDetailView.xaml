<UserControl x:Class="EstateFlow.Desktop.Views.EstateDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="QuickAddTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BorderBrush="#E4E2DD"
                BorderThickness="0,0,0,1"
                Padding="24,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="0">

                    <Button Content="← Dashboard"
                            Command="{Binding BackCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#6B6E76"
                            FontFamily="{StaticResource SansFont}"
                            FontSize="12"
                            Cursor="Hand"
                            Padding="0,0,16,0"/>

                    <TextBlock Text="{Binding Estate.FileNumber, StringFormat='File {0}'}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               Foreground="#6B6E76"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <TextBlock Text="{Binding Estate.Deceased.FullName, StringFormat='Estate of the Late {0}'}"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="16"
                               Foreground="#16181C"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding Estate.EstateStatus}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="#9C7A3C"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Loading / error -->

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="12"
                   Foreground="#9CA0A8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,40,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}"/>

        <!-- ===================================================== -->
        <!-- TABS -->
        <!-- ===================================================== -->

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="{Binding Estate, Converter={StaticResource NullToVisConverter}}">

            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,8"/>
                </Style>
            </TabControl.Resources>

            <!-- ================================================= -->
            <!-- GENERAL -->
            <!-- ================================================= -->

            <TabItem Header="General">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="FILE REFERENCE"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="File Number"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.FileNumber}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Master's Reference"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.MastersReference}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Date of Death"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.DateOfDeath, StringFormat='dd MMMM yyyy'}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Dutiable Estate"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.IsDutiable}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Status"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.EstateStatus}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ACCOUNT &amp; FEE SETTINGS" Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account Type" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.AccountType}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Testate" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.IsTestate}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date of Account" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.DateOfAccount, StringFormat='dd MMMM yyyy'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Place of Account" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.PlaceOfAccount}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Master's Office" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.MastersOffice}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Letters of Executorship" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.LettersOfExecutorshipDate, StringFormat='dd MMMM yyyy'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Executor's Fee" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.ExecutorFeePercentage, StringFormat='{}{0:0.##}%'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="VAT Registered" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.IsVatRegistered}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="VAT Rate" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.VatRate, StringFormat='{}{0:0.##}%'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Master's Fee" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.MastersFee, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Estate Duty Rebate" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.EstateDutyRebate, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Estate Duty Rate" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.EstateDutyRate, StringFormat='{}{0:0.##}%'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>
                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Source of Estate" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.SourceOfEstate}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Estate Bank" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.EstateBankName}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Branch Code" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.EstateBankBranchCode}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account Number" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.EstateBankAccountNumber}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Multiple L&amp;D Accounts" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.HasMultipleLdAccounts}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Previous Spouses" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.PreviousSpousesCount}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="4A Rebate Used (Prev.)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.PreviousSpouseRebateUsed, StringFormat='R {0:N2}'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,18,0,0"
                                Background="#FBFAF8">
                            <StackPanel>
                                <TextBlock Text="CURRENT PROGRESS"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="{Binding CurrentProgressTitle}"
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="19"
                                           Foreground="#16181C"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EFEAE4"
                                            CornerRadius="3"
                                            Padding="8,4"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding CurrentProgressStatus}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="#6E2A2A"/>
                                    </Border>

                                    <TextBlock Text="{Binding CurrentProgressSummary}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="Manage and edit the full estate timeline from the Progress tab."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           Foreground="#9CA0A8"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ESTATE OVERVIEW"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Deceased"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.FullName}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Executors"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Executors.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Heirs / Beneficiaries"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Beneficiaries.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Movable Assets"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.MovableAssets.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Immovable Properties"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.ImmovableProperties.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Financial Claims"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.FinancialClaims.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Diary Entries"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.DiaryEntries.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Progress Stages"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.ProgressStages.Count}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCardBorderStyle}"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="ESTATE ACTIONS"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Edit the estate details or permanently remove this estate."
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="12"
                                           Foreground="#6B6E76"
                                           Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Edit Estate"
                                            Command="{Binding EditCommand}"
                                            Background="Transparent"
                                            BorderThickness="1"
                                            BorderBrush="#E4E2DD"
                                            Foreground="#16181C"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Padding="14,7"
                                            Cursor="Hand"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Delete Estate"
                                            Command="{Binding DeleteEstateCommand}"
                                            Background="#8B3A3A"
                                            BorderThickness="0"
                                            Foreground="White"
                                            FontFamily="{StaticResource SansFont}"
                                            FontSize="12"
                                            Padding="14,7"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- DECEASED -->
            <!-- ================================================= -->

            <TabItem Header="Deceased">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="PARTICULARS OF THE DECEASED"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Full Names"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.FullName}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Identity Number"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.IdNumber}"
                                               Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Marital Status"
                                               Style="{StaticResource FieldLabelStyle}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Estate.Deceased.MaritalStatus}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>
                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Matrimonial Regime" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.Deceased.MatrimonialRegime}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Spouse" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.Deceased.SpouseFullName}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Spouse ID Number" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.Deceased.SpouseIdNumber}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Place of Death" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.Deceased.PlaceOfDeath}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Will Date" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.Deceased.WillDate, StringFormat='dd MMMM yyyy'}" Style="{StaticResource FieldValueMonoStyle}"/>
                                </Grid>

                                <Grid Style="{StaticResource FieldRowGrid}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Will Location" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Estate.Deceased.WillLocation}" Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================= -->
            <!-- EXECUTORS -->
            <!-- ================================================= -->

            TabItem Header="Executors">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel MaxWidth="700" HorizontalAlignment="Left">

                    <!-- ── ADD EXECUTOR ───────────────────────────────────────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="ADD EXECUTOR" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewExecutorFullName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Identity Number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewExecutorIdNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                            <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox IsEditable="True"
                              Text="{Binding NewExecutorRole, UpdateSourceTrigger=PropertyChanged}"
                              Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                <ComboBoxItem Content="Nominated Executor"/>
                                <ComboBoxItem Content="Co-Executor"/>
                                <ComboBoxItem Content="Executor Dative"/>
                                <ComboBoxItem Content="Executor Testamentary"/>
                            </ComboBox>

                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding NewExecutorEmail, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Content="+ Add Executor"
                            Command="{Binding AddExecutorCommand}"
                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                            Padding="14,7" FontFamily="{StaticResource SansFont}" FontSize="12"
                            Cursor="Hand" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── EXECUTOR LIST ──────────────────────────────────────── -->
                    <ItemsControl ItemsSource="{Binding Estate.Executors}" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SectionCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FullName}"
                                               FontFamily="{StaticResource SerifFont}" FontSize="15"
                                               Foreground="#16181C"/>
                                            <TextBlock Text="{Binding Role}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="#6B6E76" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Email}"
                                               FontFamily="{StaticResource SansFont}" FontSize="11"
                                               Foreground="#6B6E76" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Edit"
                                            Command="{Binding DataContext.SelectExecutorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="1" BorderBrush="#E4E2DD"
                                            Foreground="#16181C" Padding="10,5"
                                            FontFamily="{StaticResource SansFont}" FontSize="11"
                                            Cursor="Hand" Margin="0,0,6,0"/>
                                            <Button Content="Remove"
                                            Command="{Binding DataContext.DeleteExecutorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding ExecutorId}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="#8B3A3A" Padding="10,5"
                                            FontFamily="{StaticResource SansFont}" FontSize="11"
                                            Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── EXECUTOR DETAILS (shown after clicking Edit) ──────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SectionCardBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedExecutor}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="EXECUTOR DETAILS" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Click &#x22;Edit&#x22; on an executor above to load their details."
                               FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#6B6E76"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedExecutor}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding ExecutorDetailFullName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Identity Number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding ExecutorDetailIdNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                            <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox IsEditable="True"
                              Text="{Binding ExecutorDetailRole, UpdateSourceTrigger=PropertyChanged}"
                              Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                <ComboBoxItem Content="Nominated Executor"/>
                                <ComboBoxItem Content="Co-Executor"/>
                                <ComboBoxItem Content="Executor Dative"/>
                                <ComboBoxItem Content="Executor Testamentary"/>
                            </ComboBox>

                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding ExecutorDetailEmail, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding ExecutorDetailPhone, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                            <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding ExecutorDetailAddress, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" Height="60" AcceptsReturn="True"/>

                            <TextBlock Text="Master's Office" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox IsEditable="True"
                              Text="{Binding ExecutorDetailMastersOffice, UpdateSourceTrigger=PropertyChanged}"
                              Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                <ComboBoxItem Content="Cape Town"/>
                                <ComboBoxItem Content="Johannesburg"/>
                                <ComboBoxItem Content="Pretoria"/>
                                <ComboBoxItem Content="Durban"/>
                                <ComboBoxItem Content="Bloemfontein"/>
                                <ComboBoxItem Content="Port Elizabeth"/>
                                <ComboBoxItem Content="East London"/>
                                <ComboBoxItem Content="Kimberley"/>
                                <ComboBoxItem Content="Polokwane"/>
                                <ComboBoxItem Content="Nelspruit"/>
                                <ComboBoxItem Content="Mmabatho"/>
                                <ComboBoxItem Content="Pietermaritzburg"/>
                            </ComboBox>

                            <Button Content="Save Executor Details"
                            Command="{Binding SaveExecutorDetailCommand}"
                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                            Padding="14,7" FontFamily="{StaticResource SansFont}" FontSize="12"
                            Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- ── LETTERS OF EXECUTORSHIP ────────────────────────────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SectionCardBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedExecutor}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="LETTERS OF EXECUTORSHIP" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Issued by the Master of the High Court confirming the executor's appointment."
                               FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#6B6E76"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Reference Number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding ExecutorDetailLettersRef, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                            <TextBlock Text="Date Issued" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding ExecutorDetailLettersDate}"
                                Padding="8,6" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Upload Letters"
                                Command="{Binding UploadLettersCommand}"
                                Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                Padding="14,7" FontFamily="{StaticResource SansFont}" FontSize="12"
                                Cursor="Hand" Margin="0,0,10,0"/>
                                <Button Content="View Letters"
                                Command="{Binding ViewLettersCommand}"
                                Background="Transparent" BorderThickness="1" BorderBrush="#E4E2DD"
                                Foreground="#16181C" Padding="14,7"
                                FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLettersDocument}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding LettersDocumentName}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="#6B6E76" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLettersDocument}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ── SECTION 29 ADVERTISEMENT ───────────────────────────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SECTION 29 ADVERTISEMENT" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="Notice to creditors in the Government Gazette and a newspaper — 30 days to lodge claims."
                                       FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#6B6E76"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="3" Padding="8,4" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D4EDDA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section29Complete}" Value="False">
                                                    <Setter Property="Background" Value="#FFF3CD"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Section29Overdue}" Value="True">
                                                    <Setter Property="Background" Value="#F8D7DA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="COMPLETE"/>
                                                <Setter Property="Foreground" Value="#155724"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Section29Complete}" Value="False">
                                                        <Setter Property="Text" Value="PENDING"/>
                                                        <Setter Property="Foreground" Value="#856404"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Section29Overdue}" Value="True">
                                                        <Setter Property="Text" Value="OVERDUE"/>
                                                        <Setter Property="Foreground" Value="#721C24"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <TextBlock Text="Gazette Number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding Section29GazetteNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                            <TextBlock Text="Gazette Date" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Section29GazetteDate}" Padding="8,6" Margin="0,0,0,12"/>

                            <TextBlock Text="Newspaper Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding Section29NewspaperName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Newspaper Date" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Section29NewspaperDate}" Padding="8,6" Margin="0,0,0,12"/>

                            <TextBlock Text="Claim Deadline (30 days from last publication)" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Section29ClaimDeadline}" Padding="8,6" Margin="0,0,0,12"/>

                            <CheckBox Content="Objections / claims received"
                              IsChecked="{Binding Section29ObjectionsReceived}"
                              FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                            <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding Section29Notes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" Height="60" AcceptsReturn="True"/>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Save Section 29"
                                Command="{Binding SaveSection29Command}"
                                Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                Padding="14,7" FontFamily="{StaticResource SansFont}" FontSize="12"
                                Cursor="Hand" Margin="0,0,10,0"/>
                                <Button Content="Generate Notice Draft"
                                Command="{Binding GenerateSection29Command}"
                                Background="Transparent" BorderThickness="1" BorderBrush="#E4E2DD"
                                Foreground="#16181C" Padding="14,7"
                                FontFamily="{StaticResource SansFont}" FontSize="12" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── SECTION 35 ADVERTISEMENT ───────────────────────────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="SECTION 35 ADVERTISEMENT" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="Notice to heirs and legatees — published after the L&amp;D account lies for inspection."
                               FontFamily="{StaticResource SansFont}" FontSize="11" Foreground="#6B6E76"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Gazette Number" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding Section35GazetteNumber, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"/>

                            <TextBlock Text="Gazette Date" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Section35GazetteDate}" Padding="8,6" Margin="0,0,0,12"/>

                            <TextBlock Text="Newspaper Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding Section35NewspaperName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Newspaper Date" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Section35NewspaperDate}" Padding="8,6" Margin="0,0,0,12"/>

                            <TextBlock Text="Claim Deadline" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker SelectedDate="{Binding Section35ClaimDeadline}" Padding="8,6" Margin="0,0,0,12"/>

                            <CheckBox Content="Objections / claims received"
                              IsChecked="{Binding Section35ObjectionsReceived}"
                              FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                            <TextBlock Text="Notes" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Style="{StaticResource QuickAddTextBox}"
                             Text="{Binding Section35Notes, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" Height="60" AcceptsReturn="True"/>

                            <Button Content="Save Section 35"
                            Command="{Binding SaveSection35Command}"
                            Background="#6E2A2A" Foreground="White" BorderThickness="0"
                            Padding="14,7" FontFamily="{StaticResource SansFont}" FontSize="12"
                            Cursor="Hand" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── EXECUTOR DOCUMENT UPLOAD ───────────────────────────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SectionCardBorderStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedExecutor}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="UPLOAD EXECUTOR DOCUMENT" Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock Text="Document Category" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox IsEditable="True"
                              Text="{Binding SelectedDocumentType, UpdateSourceTrigger=PropertyChanged}"
                              Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                <ComboBoxItem Content="Letters of Executorship"/>
                                <ComboBoxItem Content="Death Certificate"/>
                                <ComboBoxItem Content="Identity Document"/>
                                <ComboBoxItem Content="Will"/>
                                <ComboBoxItem Content="Power of Attorney"/>
                                <ComboBoxItem Content="Correspondence"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>

                            <TextBlock Text="{Binding SelectedFileName, TargetNullValue='No file selected'}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="#6B6E76" Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose File"
                                Command="{Binding ChooseFileCommand}"
                                Background="Transparent" BorderThickness="1" BorderBrush="#E4E2DD"
                                Foreground="#16181C" Padding="14,7"
                                FontFamily="{StaticResource SansFont}" FontSize="12"
                                Cursor="Hand" Margin="0,0,10,0"/>
                                <Button Content="Upload"
                                Command="{Binding UploadCommand}"
                                Background="#6E2A2A" Foreground="White" BorderThickness="0"
                                Padding="14,7" FontFamily="{StaticResource SansFont}" FontSize="12"
                                Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanUpload}" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── EXECUTOR DOCUMENT REGISTRY ─────────────────────────── -->
                    <Border Style="{StaticResource SectionCardBorderStyle}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="EXECUTOR DOCUMENT REGISTRY" Style="{StaticResource SectionTitleStyle}"/>

                            <ItemsControl ItemsSource="{Binding ExecutorDocuments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E4E2DD" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding FileName}"
                                                       FontFamily="{StaticResource SansFont}" FontSize="12"
                                                       Foreground="#16181C"/>
                                                    <TextBlock Text="{Binding DocumentType}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="#6B6E76" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding UploadedAt, StringFormat='Uploaded {0:dd MMM yyyy}'}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                       Foreground="#9CA0A8"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="View"
                                                    Command="{Binding DataContext.ViewDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding DocumentId}"
                                                    Background="Transparent" BorderThickness="1" BorderBrush="#E4E2DD"
                                                    Foreground="#16181C" Padding="10,5"
                                                    FontFamily="{StaticResource SansFont}" FontSize="11"
                                                    Cursor="Hand" Margin="0,0,6,0"/>
                                                    <Button Content="Delete"
                                                    Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding DocumentId}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Foreground="#8B3A3A" Padding="10,5"
                                                    FontFamily="{StaticResource SansFont}" FontSize="11"
                                                    Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No documents uploaded yet."
                               FontFamily="{StaticResource SansFont}" FontSize="12"
                               Foreground="#9CA0A8" Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExecutorDocuments.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
            </TabItem>


            <!-- ================================================= -->
            <!-- HEIRS -->
            <!-- ================================================= -->

            <TabItem Header="Heirs">
                <ScrollViewer Padding="20">
                    <StackPanel MaxWidth="700"
                                HorizontalAlignment="Left">

                        <Border Style="{StaticResource SectionCardBorderStyle}">
                            <StackPanel>

                                <TextBlock Text="ADD HEIR / BENEFICIARY"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="First Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryFirstName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Middle Name(s)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryMiddleName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Surname" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiarySurname, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Identity Number"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryIdNumber, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <TextBlock Text="Email"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryEmail, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Relationship"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox IsEditable="True"
                                          Text="{Binding NewBeneficiaryRelationship, UpdateSourceTrigger=PropertyChanged}"
                                          Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Spouse"/>
                                    <ComboBoxItem Content="Child"/>
                                    <ComboBoxItem Content="Parent"/>
                                    <ComboBoxItem Content="Sibling"/>
                                    <ComboBoxItem Content="Grandchild"/>
                                    <ComboBoxItem Content="Other family member"/>
                                    <ComboBoxItem Content="Friend"/>
                                    <ComboBoxItem Content="Charity / Institution"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>

                                <TextBlock Text="Heir Type"
                                           Style="{StaticResource FieldLabelStyle}"/>

                                <ComboBox SelectedValuePath="Content"
                                          SelectedValue="{Binding NewBeneficiaryHeirType}"
                                          Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Natural Person"/>
                                    <ComboBoxItem Content="Charity (s4h exempt)"/>
                                    <ComboBoxItem Content="Trust"/>
                                    <ComboBoxItem Content="Other Legal Entity"/>
                                </ComboBox>
                                <TextBlock Text="Relationship Description (e.g. daughter)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryRelationshipDescription, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabelStyle}"/>
                                <DatePicker SelectedDate="{Binding NewBeneficiaryDateOfBirth}" Padding="8,6" Margin="0,0,0,12"/>

                                <TextBlock Text="Gender" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewBeneficiaryGender}"
                                          Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Male"/>
                                    <ComboBoxItem Content="Female"/>
                                </ComboBox>

                                <TextBlock Text="Marital Status" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox SelectedValuePath="Content" SelectedValue="{Binding NewBeneficiaryMaritalStatus}"
                                          Padding="8,6" FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Single"/>
                                    <ComboBoxItem Content="Married"/>
                                    <ComboBoxItem Content="Divorced"/>
                                    <ComboBoxItem Content="Widowed"/>
                                    <ComboBoxItem Content="Life Partnership"/>
                                </ComboBox>

                                <TextBlock Text="Will Clause" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryWillClause, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Text="Cash Legacy Amount (R)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryCashLegacyAmount, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <TextBlock Text="Portion of Residue (leave blank if special bequests only; 1 / 1 = entire residue)" Style="{StaticResource FieldLabelStyle}"/>
