                                    <TextBox Style="{StaticResource QuickAddTextBox}" Width="70"
                                             Text="{Binding NewBeneficiaryResidueNumerator, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text=" / " VerticalAlignment="Center" Margin="6,0"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}" Width="70"
                                             Text="{Binding NewBeneficiaryResidueDenominator, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>

                                <TextBlock Text="Advances Paid After Death (R)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryAdvancesPaid, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}"/>

                                <CheckBox Content="Surviving spouse (required if married in community of property)"
                                          IsChecked="{Binding NewBeneficiaryIsSurvivingSpouse}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                                <CheckBox Content="Predeceased" IsChecked="{Binding NewBeneficiaryIsPredeceased}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                                <CheckBox Content="Minor" IsChecked="{Binding NewBeneficiaryIsMinor}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock Text="Guardian / Trustee (if minor)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryGuardianOrTrustee, UpdateSourceTrigger=PropertyChanged}"/>

                                <CheckBox Content="Ultimate beneficiary from a previous estate (bare dominium holder)"
                                          IsChecked="{Binding NewBeneficiaryIsUltimateBeneficiary}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock Text="Bare Dominium Fraction (e.g. 1/2)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Style="{StaticResource QuickAddTextBox}"
                                         Text="{Binding NewBeneficiaryBareDominiumFraction, UpdateSourceTrigger=PropertyChanged}"
