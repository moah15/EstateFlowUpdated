                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <CheckBox Content="Special bequest" IsChecked="{Binding NewAssetIsSpecialBequest}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,8"/>

                                <CheckBox Content="Sold / reduced to cash by the estate" IsChecked="{Binding NewAssetIsSoldOrReducedToCash}"
                                          FontFamily="{StaticResource SansFont}" FontSize="12" Margin="0,0,0,10"/>

                                <StackPanel Visibility="{Binding NewAssetIsSoldOrReducedToCash, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="Sale Proceeds (R)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Style="{StaticResource QuickAddTextBox}"
                                             Text="{Binding NewAssetSaleProceeds, UpdateSourceTrigger=PropertyChanged}"
