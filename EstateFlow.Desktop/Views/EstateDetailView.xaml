                                                           FontFamily="{StaticResource SansFont}"
                                                           FontSize="11"
                                                           Foreground="#6E2A2A"
                                                           Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Text="{Binding Relationship}"
                                                               Style="{StaticResource FieldLabelStyle}"
                                                               Margin="0,0,16,0"/>

                                                    <Border Background="#F5F4F1"
                                                            BorderBrush="#E4E2DD"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            Padding="6,2">

                                                        <TextBlock Text="{Binding HeirType}"
                                                                   FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10"
                                                                   Foreground="#6B6E76"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Command="{Binding DataContext.DeleteBeneficiaryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding BeneficiaryId}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8B3A3A"
                                                    FontFamily="{StaticResource SansFont}"
                                                    FontSize="11"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

