<UserControl x:Class="EstateFlow.Desktop.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="3,0,0,0"
                                CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A2D33"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavDashboard" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="dashboard">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavEstates" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="estates">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="estate-detail">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="new-estate">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="edit-estate">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavDiary" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="diary">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavDocuments" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="document-scan">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavReports" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentScreen}" Value="reports">
                    <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource UrgentDueSoonBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Width="224" Background="{StaticResource BgPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Wordmark -->
        <StackPanel Grid.Row="0" Margin="20,22,20,6">
            <TextBlock Text="EstateFlow" Style="{StaticResource HeadingSerifStyle}" FontSize="20"/>
            <TextBlock Text="ESTATE ADMINISTRATION" Style="{StaticResource MonoLabelStyle}"
                       FontSize="9" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10,18,10,0">
            <TextBlock Text="NAVIGATION" Style="{StaticResource MonoLabelStyle}"
                       FontSize="9" Margin="12,0,0,8"/>

            <Button Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                    Style="{StaticResource NavDashboard}"/>
            <Button Content="Estates" Command="{Binding NavigateCommand}" CommandParameter="estates"
                    Style="{StaticResource NavEstates}"/>
            <Button Content="Diary" Command="{Binding NavigateCommand}" CommandParameter="diary"
                    Style="{StaticResource NavDiary}"/>
            <Button Content="Documents" Command="{Binding NavigateCommand}" CommandParameter="document-scan"
                    Style="{StaticResource NavDocuments}"/>
            <Button Content="Reports" Command="{Binding NavigateCommand}" CommandParameter="reports"
                    Style="{StaticResource NavReports}"/>

            <Button Content="+  New Estate" Command="{Binding NavigateCommand}" CommandParameter="new-estate"
                    Style="{StaticResource NavButton}" Margin="0,18,0,0" Foreground="#9C7A3C"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="16,0,16,14">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="{Binding UserInitials}" Style="{StaticResource BodyTextStyle}"
                                       FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Style="{StaticResource BodyTextStyle}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            <TextBlock Text="Estate controller" Style="{StaticResource MonoLabelStyle}"
                                       FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Sign out" Command="{Binding LogoutCommand}"
                            HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextDimBrush}" FontFamily="{StaticResource SansFont}"
                            FontSize="12" Padding="0" Margin="0,12,0,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
