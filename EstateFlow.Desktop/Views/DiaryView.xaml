<UserControl x:Class="EstateFlow.Desktop.Views.DiaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F4F1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E4E2DD"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Diary Correspondence"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="20"
                               Foreground="#16181C"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               Foreground="#6B6E76"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent"
                        BorderBrush="#D7D4CE"
                        BorderThickness="1"
                        Foreground="#16181C"
                        FontFamily="{StaticResource SansFont}"
                        FontSize="12"
                        Padding="14,7"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: diary entry list -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#E4E2DD"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="#F0EEE9"
                            BorderBrush="#E4E2DD"
                            BorderThickness="0,0,0,1"
                            Padding="16,11">
                        <TextBlock Text="DIARY ENTRIES"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="#6B6E76"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"
                                        Value="0"/>
                                <Setter Property="Margin"
                                        Value="0"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="#ECEAE5"
                                                    BorderThickness="0,0,0,1">
                                                <ContentPresenter/>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#F8F7F4"/>
                                                </Trigger>

                                                <Trigger Property="IsSelected"
                                                         Value="True">
                                                    <Setter TargetName="ItemBorder"
                                                            Property="Background"
                                                            Value="#EFE8E4"/>
                                                    <Setter TargetName="ItemBorder"
                                                            Property="BorderBrush"
                                                            Value="#CBB7AE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="15,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding FileNumber}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="#6E2A2A"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DueDate, StringFormat='dd MMM'}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="#6B6E76"/>
                                    </Grid>

                                    <TextBlock Text="{Binding DeceasedFullName}"
                                               FontFamily="{StaticResource SerifFont}"
                                               FontSize="14"
                                               Foreground="#16181C"
                                               Margin="0,5,0,4"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding Note}"
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="11"
                                               Foreground="#6B6E76"
                                               TextWrapping="Wrap"
                                               MaxHeight="38"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: correspondence preview + send controls -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Letter preview -->
                <Border Grid.Row="0"
                        Background="#E9E6DF"
                        BorderBrush="#D7D4CE"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#FFFFFF"
                                BorderBrush="#D8D5CE"
                                BorderThickness="1"
                                Padding="44,38"
                                MaxWidth="720"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="ESTATEFLOW"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#6E2A2A"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Estate Diary Correspondence"
                                           FontFamily="{StaticResource SerifFont}"
                                           FontSize="24"
                                           Foreground="#16181C"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,28"/>

                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Estate"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding PreviewEstateName}"
                                               Style="{StaticResource FieldValueStyle}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="1"
                                               Text="File Number"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding PreviewFileNumber}"
                                               Style="{StaticResource FieldValueMonoStyle}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="2"
                                               Text="Due Date"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding PreviewDueDate}"
                                               Style="{StaticResource FieldValueStyle}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="3"
                                               Text="Status"
                                               Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,0,0,7"/>
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding PreviewStatus}"
                                               Style="{StaticResource FieldValueStyle}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Grid.Row="4"
                                               Text="Notify By"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBlock Grid.Row="4"
                                               Grid.Column="1"
                                               Text="{Binding PreviewNotificationMethod}"
                                               Style="{StaticResource FieldValueStyle}"/>
                                </Grid>

                                <Border BorderBrush="#E4E2DD"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Diary Note"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="#9CA0A8"
                                                   Margin="0,0,0,12"/>

                                        <TextBlock Text="{Binding PreviewBody}"
                                                   FontFamily="{StaticResource SerifFont}"
                                                   FontSize="16"
                                                   LineHeight="25"
                                                   Foreground="#16181C"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Regards,"
                                                   FontFamily="{StaticResource SerifFont}"
                                                   FontSize="14"
                                                   Foreground="#16181C"
                                                   Margin="0,34,0,0"/>

                                        <TextBlock Text="EstateFlow Estate Administration"
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="12"
                                                   Foreground="#6B6E76"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Border>

                <!-- Email send panel -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        BorderBrush="#E4E2DD"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="SEND THIS DIARY ENTRY BY EMAIL"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="#6B6E76"
                                   Margin="0,0,0,10"/>

                        <Grid Grid.Row="1"
                              Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Saved recipient"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>

                                <ComboBox ItemsSource="{Binding RecipientOptions}"
                                          SelectedItem="{Binding SelectedRecipient}"
                                          DisplayMemberPath="DisplayText"
                                          Height="34"
                                          Padding="8,4"
                                          Background="#FFFFFF"
                                          BorderBrush="#D7D4CE"
                                          FontFamily="{StaticResource SansFont}"
                                          FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Recipient name"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         Padding="9,6"
                                         Background="#FFFFFF"
                                         BorderBrush="#D7D4CE"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource SansFont}"
                                         FontSize="12"
                                         Foreground="#16181C"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2"
                              Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Recipient email"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding RecipientEmail, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         Padding="9,6"
                                         Background="#FFFFFF"
                                         BorderBrush="#D7D4CE"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource SansFont}"
                                         FontSize="12"
                                         Foreground="#16181C"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Subject"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,0,0,4"/>

                                <TextBox Text="{Binding EmailSubject, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         Padding="9,6"
                                         Background="#FFFFFF"
                                         BorderBrush="#D7D4CE"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource SansFont}"
                                         FontSize="12"
                                         Foreground="#16181C"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Choose a saved estate contact or overwrite the fields to send to any email address."
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="10"
                                       Foreground="#9CA0A8"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,16,0"/>

                            <Button Grid.Column="1"
                                    Content="Send Email"
                                    Command="{Binding SendEmailCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="22,10"
                                    MinWidth="120"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
