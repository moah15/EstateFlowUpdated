<UserControl x:Class="EstateFlow.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BgMainBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">

            <Ellipse Width="56" Height="56" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="EF" HorizontalAlignment="Center" Margin="0,-42,0,0"
                       Foreground="{StaticResource TextBrightBrush}"
                       FontFamily="{StaticResource MonoFont}" FontSize="16"/>

            <TextBlock Text="EstateFlow" Style="{StaticResource HeadingSerifStyle}"
                       HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock
                       Style="{StaticResource MonoLabelStyle}"
                       HorizontalAlignment="Center" Margin="0,0,0,32"><Run Language="en-za" Text="E"/><Run Text="stateFlow"/><Run Text=" · Deceased Estate Administration"/></TextBlock>

            <!-- Step 1: email + password -->
            <StackPanel Visibility="{Binding RequiresTwoFactor, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                <TextBlock Text="EMAIL" Style="{StaticResource MonoLabelStyle}" Margin="2,0,0,6"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource DarkTextBoxStyle}"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="PASSWORD" Style="{StaticResource MonoLabelStyle}" Margin="2,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBoxStyle}"
                             Margin="0,0,0,24"/>

                <Button Content="Sign In" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Step 2: two-factor code (Firm Administrator only) -->
            <StackPanel Visibility="{Binding RequiresTwoFactor, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="AUTHENTICATION CODE" Style="{StaticResource MonoLabelStyle}" Margin="2,0,0,6"/>
                <TextBlock Text="Enter the 6-digit code from your authenticator app."
                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource SansFont}"
                           FontSize="12" Margin="2,0,0,10" TextWrapping="Wrap"/>
                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                         Text="{Binding TwoFactorCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,24" MaxLength="6"/>

                <Button Content="Verify" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding VerifyTwoFactorCommand}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource UrgentOverdueBrush}"
                       FontFamily="{StaticResource SansFont}" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"/>

        </StackPanel>
    </Grid>
</UserControl>