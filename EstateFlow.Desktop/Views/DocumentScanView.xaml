<UserControl x:Class="EstateFlow.Desktop.Views.DocumentScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F4F1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                BorderBrush="#E4E2DD"
                BorderThickness="0,0,0,1"
                Padding="24,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="{Binding HeaderText}"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="17"
                               Foreground="#16181C"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="#6B6E76"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Background="Transparent"
                        BorderBrush="#E4E2DD"
                        BorderThickness="1"
                        Foreground="#16181C"
                        FontFamily="{StaticResource SansFont}"
                        FontSize="12"
                        Padding="12,6"
                        Cursor="Hand"
                        VerticalAlignment="Center"/>

            </Grid>

        </Border>

        <!-- ===================================================== -->
        <!-- CONTENT -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      Padding="24"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel MaxWidth="700"
                        HorizontalAlignment="Left">


                <!-- ================================================= -->
                <!-- ESTATE SELECTOR -->
                <!-- ================================================= -->

                <Border Background="#FFFFFF"
                        BorderBrush="#E4E2DD"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="18"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="SELECT ESTATE"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="#9CA0A8"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Choose the estate this document belongs to"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="#6B6E76"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding Estates}"
                                  SelectedItem="{Binding SelectedEstate, Mode=TwoWay}"
                                  Background="#FFFFFF"
                                  BorderBrush="#E4E2DD"
                                  BorderThickness="1"
                                  Padding="9,7"
                                  FontFamily="{StaticResource SansFont}"
                                  FontSize="12"
                                  HorizontalContentAlignment="Stretch">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FileNumber}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="#6E2A2A"
                                                   Margin="0,0,12,0"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DeceasedFullName}"
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="12"
                                                   Foreground="#16181C"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->
                <!-- UPLOAD DOCUMENT -->
                <!-- ================================================= -->

                <Border Background="#FFFFFF"
                        BorderBrush="#E4E2DD"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="18"
                        Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock Text="UPLOAD SCANNED DOCUMENT"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="#9CA0A8"
                                   Margin="0,0,0,16"/>

                        <!-- Document Type -->

                        <TextBlock Text="Document Type"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="#6B6E76"
                                   Margin="0,0,0,5"/>

                        <TextBox Text="{Binding NewDocumentType,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource SansFont}"
                                 FontSize="12"
                                 Foreground="#16181C"
                                 Background="#FFFFFF"
                                 BorderBrush="#E4E2DD"
                                 BorderThickness="1"
                                 Padding="9,7"
                                 Margin="0,0,0,14"/>

                        <!-- File Picker -->

                        <TextBlock Text="File"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="#6B6E76"
                                   Margin="0,0,0,5"/>

                        <Grid Margin="0,0,0,14">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#F8F7F4"
                                    BorderBrush="#E4E2DD"
                                    BorderThickness="1"
                                    Padding="10,8"
                                    Margin="0,0,8,0">

                                <TextBlock Text="{Binding SelectedFileName}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11"
                                           Foreground="#6B6E76"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                            </Border>

                            <Button Grid.Column="1"
                                    Content="Choose File"
                                    Command="{Binding ChooseFileCommand}"
                                    Background="Transparent"
                                    BorderBrush="#E4E2DD"
                                    BorderThickness="1"
                                    Foreground="#16181C"
                                    FontFamily="{StaticResource SansFont}"
                                    FontSize="12"
                                    Padding="12,7"
                                    Cursor="Hand"/>

                        </Grid>

                        <!-- Upload -->

                        <Button Content="Upload Document"
                                Command="{Binding UploadCommand}"
                                IsEnabled="{Binding CanUpload}"
                                Background="#6E2A2A"
                                Foreground="White"
                                BorderThickness="0"
                                FontFamily="{StaticResource SansFont}"
                                FontSize="12"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Cursor="Hand"/>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->
                <!-- DOCUMENT REGISTRY -->
                <!-- ================================================= -->

                <Border Background="#FFFFFF"
                        BorderBrush="#E4E2DD"
                        BorderThickness="1"
                        CornerRadius="4">

                    <StackPanel>

                        <!-- Registry heading -->

                        <Border BorderBrush="#E4E2DD"
                                BorderThickness="0,0,0,1"
                                Background="#F8F7F4"
                                Padding="16,10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="REGISTRY — SCANNED DOCUMENTS"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10"
                                           Foreground="#9CA0A8"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Documents.Count,
                                                        StringFormat='{}{0} document(s)'}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10"
                                           Foreground="#9CA0A8"/>

                            </Grid>

                        </Border>

                        <!-- Documents -->

                        <ItemsControl ItemsSource="{Binding Documents}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border BorderBrush="#E4E2DD"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,12">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Document info -->

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,16,0">

                                                <TextBlock Text="{Binding FileName}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12"
                                                           Foreground="#16181C"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,5,0,0">

                                                    <TextBlock Text="{Binding DocumentType}"
                                                               FontFamily="{StaticResource SansFont}"
                                                               FontSize="11"
                                                               Foreground="#6B6E76"
                                                               Margin="0,0,14,0"/>

                                                    <TextBlock Text="{Binding UploadDate,
                                                                            StringFormat='Uploaded {0:dd MMM yyyy}'}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="10"
                                                               Foreground="#9CA0A8"/>

                                                </StackPanel>

                                            </StackPanel>

                                            <!-- Actions -->

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">

                                                <Button Content="View / Download"
                                                        Command="{Binding DataContext.ViewDocumentCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderBrush="#E4E2DD"
                                                        BorderThickness="1"
                                                        Foreground="#16181C"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"
                                                        Margin="0,0,0,7"/>

                                                <Button Content="Delete"
                                                        Command="{Binding DataContext.DeleteDocumentCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderBrush="#B94A48"
                                                        BorderThickness="1"
                                                        Foreground="#B94A48"
                                                        FontFamily="{StaticResource SansFont}"
                                                        FontSize="11"
                                                        Padding="10,6"
                                                        Cursor="Hand"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>